# === CognoDB (Graph Database) ===
# Get these from your CognoDB dashboard after creating an instance.
COGNODB_URI=bolt+s://your-instance.cognodb.example:7687
COGNODB_USER=cognodb
COGNODB_PASSWORD=your_password_here

# === Groq AI ===
# Get your API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# === Frontend ===
# URL where the FastAPI backend is running (used by Next.js frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000
